datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkItemType {
  TASK
  BUG
  INCIDENT
  FEATURE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum ActivityEventType {
  CREATED
  ASSIGNED
  CLAIMED
  UPDATED
  TRANSITIONED
  COMMENT_ADDED
  APPROVED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  createdItems    WorkItem[]       @relation("CreatedItems")
  assignedItems   WorkItem[]       @relation("AssignedItems")
  comments        Comment[]
  activities      ActivityEvent[]
  idempotencyKeys IdempotencyKey[]

  @@map("users")
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  workItems   WorkItem[]

  @@map("teams")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, role])
  @@map("memberships")
}

model WorkItem {
  id          String         @id @default(uuid())
  title       String
  description String
  type        WorkItemType   @default(TASK)
  priority    Priority       @default(MEDIUM)
  status      WorkItemStatus @default(OPEN)
  teamId      String
  creatorId   String
  assigneeId  String?
  dueDate     DateTime?
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator    User            @relation("CreatedItems", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee   User?           @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments   Comment[]
  activities ActivityEvent[]

  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([teamId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([assigneeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("work_items")
}

model ActivityEvent {
  id         String            @id @default(uuid())
  workItemId String
  actorId    String
  eventType  ActivityEventType
  metadata   Json              @default("{}")
  createdAt  DateTime          @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("activity_events")
}

model Comment {
  id         String   @id @default(uuid())
  workItemId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt(sort: Asc)])
  @@map("comments")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  userId         String
  operation      String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([key])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id          String       @id @default(uuid())
  eventType   String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(5)
  leaseUntil  DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  notification Notification?

  @@index([status, leaseUntil, createdAt])
  @@map("outbox_events")
}

model Notification {
  id            String   @id @default(uuid())
  outboxEventId String   @unique
  recipientId   String?
  title         String
  message       String
  createdAt     DateTime @default(now())

  outboxEvent OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
