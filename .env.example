# Server Environment
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
CORS_ORIGIN=http://localhost:5173

# Database Connections (PostgreSQL 17)
DATABASE_URL=postgresql://postgres@localhost:5433/newtonite_ops?schema=public
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/newtonite_test?schema=public

# Background Worker Settings
WORKER_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=5
